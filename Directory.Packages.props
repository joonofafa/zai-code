<Project>
  <!-- 중앙 집중식 패키지 버전 관리 (Central Package Management) -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Spectre.Console" Version="0.50.0" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="CliWrap" Version="3.7.1" />
    <!-- 닫힌 Office 문서 생성/검증(Open XML SDK). 전 플랫폼(net10.0). -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageVersion Include="PdfPig" Version="0.1.15" />
    <!-- OpenXml 이 끌어오는 System.IO.Packaging 8.0.0(NU1903 취약)을 패치본으로 강제 override. -->
    <PackageVersion Include="System.IO.Packaging" Version="9.0.8" />
    <PackageVersion Include="System.CommandLine" Version="2.0.9" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
