<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MoAI Desktop 은 CLI(moai, 1.8.x)와 독립 버전 — 아직 초기 단계. -->
    <Version>0.4.79</Version>
    <!-- Windows 전용 데스크톱 — COM Office 편집 툴 참조를 위해 net10.0-windows 로 타깃(Directory.Build.props 오버라이드). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- NU1903: Tmds.DBus.Protocol 은 Avalonia 의 리눅스(X11) 백엔드 전용 전이 의존성이다.
         이 앱은 Windows 대상이라 win-x64 게시 시 리눅스 백엔드가 포함되지 않는다(취약 코드 미배포). -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 코어 in-process 임베드 (데몬·IPC 없음). Bash 어셈블리는 참조하지 않음(일반 사용자 안전). -->
    <ProjectReference Include="..\MoaiCode.Core\MoaiCode.Core.csproj" />
    <ProjectReference Include="..\MoaiCode.Config\MoaiCode.Config.csproj" />
    <ProjectReference Include="..\MoaiCode.Localization\MoaiCode.Localization.csproj" />
    <ProjectReference Include="..\MoaiCode.Providers\MoaiCode.Providers.csproj" />
    <!-- 스킬 지원(SkillTool/SkillLoader/BundledSkills/PluginLoader) — CLI 와 동일한 스킬 배선. -->
    <ProjectReference Include="..\MoaiCode.Mcp\MoaiCode.Mcp.csproj" />
    <ProjectReference Include="..\MoaiCode.Tools\MoaiCode.Tools.csproj" />
    <ProjectReference Include="..\MoaiCode.Tools.OpenXml\MoaiCode.Tools.OpenXml.csproj" />
    <!-- COM Office 편집 툴('열려있는 문서 편집') — Desktop 전용. net10.0-windows 필요. -->
    <ProjectReference Include="..\MoaiCode.Tools.Office\MoaiCode.Tools.Office.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
