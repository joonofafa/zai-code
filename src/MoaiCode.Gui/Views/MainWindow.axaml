<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoaiCode.Gui.ViewModels"
        xmlns:views="using:MoaiCode.Gui.Views"
        xmlns:controls="using:MoaiCode.Gui.Controls"
        x:Class="MoaiCode.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MoAI Desktop"
        Width="860" Height="1040" MinWidth="700" MinHeight="680"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- 새 문서 템플릿 카드(문서 편집 탭, 열린 문서 없음) -->
    <DataTemplate x:Key="DocTemplateCard" x:DataType="vm:DocTemplate">
      <Button Classes="recentcard" Margin="0,0,10,10" Padding="11,10"
              Command="{Binding $parent[ItemsControl].DataContext.UseTemplateCommand}"
              CommandParameter="{Binding}">
        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="7" Background="{Binding Swatch}">
            <TextBlock Text="＋" FontSize="15" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsBlank}" />
          </Border>
          <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid>

    <!-- ═══ 로그인 (전체 창, 미인증) ═══ -->
    <Panel IsVisible="{Binding !IsAuthed}">
      <views:LoginView DataContext="{Binding Login}" />
    </Panel>

    <!-- ═══ 앱 (인증) — 상단 타이틀바 + 탭 + 콘텐츠 + (편집 대화 시)컴포저 ═══ -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsAuthed}">

      <!-- ── 타이틀바 ── -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="18,14,16,10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <Image Source="avares://MoaiCode.Gui/Assets/moai-logo.png" Width="30" Height="30" />
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="MoAI Desktop" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AppVersion}" FontSize="10.5" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
            <TextBlock Text="문서를 말로 편집하세요" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- 공유 동기화 상태(공유 폴더 탭에서만) -->
        <Border Grid.Column="2" IsVisible="{Binding IsFoldersTab}" VerticalAlignment="Center" Margin="0,0,12,0"
                Background="{DynamicResource ActivityBgBrush}" CornerRadius="999" Padding="10,4">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource GoodBrush}" />
            <TextBlock Text="{Binding SyncStatus}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource GoodBrush}" />
          </StackPanel>
        </Border>

        <TextBlock Grid.Column="3" Text="{Binding AccountLabel}" FontSize="12.5" VerticalAlignment="Center"
                   Margin="0,0,8,0" TextTrimming="CharacterEllipsis" MaxWidth="220"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <Button Grid.Column="4" Classes="ghost" Padding="7,5" VerticalAlignment="Center"
                Command="{Binding OpenSettingsCommand}" ToolTip.Tip="계정 · 모델 설정">
          <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
        </Button>
      </Grid>

      <!-- ── 탭 바 ── -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="16,0,0,0">
          <Button Classes="ghost" Padding="14,10" Background="Transparent" BorderThickness="0"
                  Command="{Binding ShowFoldersTabCommand}">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon sm" Data="{StaticResource Icon.RefreshCw}" VerticalAlignment="Center" />
                <TextBlock Text="공유 폴더" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
              <Border Height="2.5" CornerRadius="2" IsVisible="{Binding IsFoldersTab}"
                      Background="{DynamicResource AccentHoverBrush}" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Padding="14,10" Background="Transparent" BorderThickness="0"
                  Command="{Binding ShowEditTabCommand}">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon sm" Data="{StaticResource Icon.Pencil}" VerticalAlignment="Center" />
                <TextBlock Text="문서 편집" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
              <Border Height="2.5" CornerRadius="2" IsVisible="{Binding IsEditTab}"
                      Background="{DynamicResource AccentHoverBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- ── 콘텐츠 (Row2): 설정 / 공유 폴더 / 편집(목록·대화·없음) 을 Z겹침, IsVisible 전환 ── -->

      <!-- 설정 -->
      <views:SettingsView Grid.Row="2" IsVisible="{Binding ShowSettings}" />

      <!-- 탭1: 공유 폴더 대시보드 -->
      <ScrollViewer Grid.Row="2" IsVisible="{Binding IsFoldersTab}" Padding="28,22,28,24"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="16">

          <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource GoodBrush}" />
                  <TextBlock Text="공유 동기화 실행 중" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding SyncStatus}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding WatchedFolderCount}" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="감시 중 폴더" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="연결된 폴더" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <ItemsControl ItemsSource="{Binding Folders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderRow">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="13,11" Margin="0,0,0,9">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Path Grid.Column="0" Classes="icon" Data="{StaticResource Icon.FolderOpen}"
                          VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Display}" FontSize="13.5" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="999" Padding="7,1">
                          <TextBlock Text="{Binding OrgLabel}" FontSize="10.5"
                                     Foreground="{DynamicResource AccentHoverBrush}" />
                        </Border>
                        <Border Background="{DynamicResource ActivityBgBrush}" CornerRadius="999" Padding="7,1">
                          <TextBlock Text="{Binding VisibilityLabel}" FontSize="10.5"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="ghost" Padding="8,6" VerticalAlignment="Center"
                            ToolTip.Tip="폴더 열기"
                            Command="{Binding $parent[ItemsControl].DataContext.OpenFolderCommand}"
                            CommandParameter="{Binding}">
                      <Path Classes="icon sm" Data="{StaticResource Icon.FolderOpen}" VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="3" Classes="ghost" Padding="8,6" VerticalAlignment="Center" Margin="4,0,0,0"
                            ToolTip.Tip="연결 해제"
                            Command="{Binding $parent[ItemsControl].DataContext.UnlinkFolderCommand}"
                            CommandParameter="{Binding}">
                      <Path Classes="icon sm" Data="{StaticResource Icon.Unlink}" VerticalAlignment="Center" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="12" Margin="0,0,5,0" Click="OnAddSharedFolderClick" ToolTip.Tip="이 폴더의 문서를 조직 구성원과 공유"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10">
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <Path Classes="icon sm" Data="{StaticResource Icon.Plus}" VerticalAlignment="Center" />
                <TextBlock Text="조직 공유 폴더" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="12" Margin="5,0,0,0" Click="OnAddPrivateFolderClick" ToolTip.Tip="이 폴더의 문서는 나만 볼 수 있게 반영"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10">
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <Path Classes="icon sm" Data="{StaticResource Icon.Plus}" VerticalAlignment="Center" />
                <TextBlock Text="나만 보기 폴더" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Text="조직 공유 폴더의 문서는 조직 구성원이, 나만 보기 폴더의 문서는 본인만 검색할 수 있습니다. 창을 닫아도 트레이에서 계속 동작합니다."
                     FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="2,4,0,0" />
        </StackPanel>
      </ScrollViewer>

      <!-- 탭2-A: 열린 문서 목록(눌러서 편집) -->
      <Grid Grid.Row="2" IsVisible="{Binding IsEditList}" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,20,28,10">
          <StackPanel Grid.Column="0">
            <TextBlock Text="열려 있는 Office 문서" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="편집할 문서를 눌러 선택하세요" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Padding="9,6" VerticalAlignment="Center"
                  Command="{Binding RefreshOfficeCommand}" ToolTip.Tip="목록 새로고침">
            <Path Classes="icon sm" Data="{StaticResource Icon.RefreshCw}" />
          </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="28,0,28,24" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding OfficeDocs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="recentcard" Margin="0,0,0,9" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding $parent[ItemsControl].DataContext.PickOpenDocCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="이 문서로 편집 시작">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Margin="0,0,13,0"
                            Background="{DynamicResource AccentSoftBrush}">
                      <Path Data="{Binding App, Converter={x:Static vm:Converters.AppIcon}}"
                            Stroke="{Binding App, Converter={x:Static vm:Converters.AppBrush}}"
                            StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                            Width="20" Height="20" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="13.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8"
                            Padding="12,6" VerticalAlignment="Center">
                      <TextBlock Text="편집" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentHoverBrush}" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- 탭2-B: 열린 문서 없음 → 새 문서 템플릿 갤러리(카드 클릭=프롬프트 자동입력, 빈 문서=바로 열기) -->
      <ScrollViewer Grid.Row="2" IsVisible="{Binding IsEditNone}" Padding="24,20,24,26"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="18">
          <StackPanel Spacing="3">
            <TextBlock Text="새 문서로 시작" FontSize="17" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"
                       Text="템플릿을 고르면 입력창에 프롬프트가 채워집니다. 주제를 넣고 보내면 그 서식으로 작성해요. 빈 문서는 바로 열립니다." />
          </StackPanel>

          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="9" Height="9" CornerRadius="2" Background="#2B579A" VerticalAlignment="Center" />
              <TextBlock Text="Word" FontSize="12.5" FontWeight="Bold" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding WordTemplates}" ItemTemplate="{StaticResource DocTemplateCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="9" Height="9" CornerRadius="2" Background="#C43E1C" VerticalAlignment="Center" />
              <TextBlock Text="PowerPoint" FontSize="12.5" FontWeight="Bold" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding PptTemplates}" ItemTemplate="{StaticResource DocTemplateCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="9" Height="9" CornerRadius="2" Background="#217346" VerticalAlignment="Center" />
              <TextBlock Text="Excel" FontSize="12.5" FontWeight="Bold" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ExcelTemplates}" ItemTemplate="{StaticResource DocTemplateCard}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>

          <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding RefreshOfficeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon sm" Data="{StaticResource Icon.RefreshCw}" VerticalAlignment="Center" />
              <TextBlock Text="열린 문서 새로고침" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>

      <!-- 탭2-C: 편집 대화 (문서 선택 후) -->
      <Grid Grid.Row="2" IsVisible="{Binding IsEditChat}" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="16,10,16,6">
          <Button Grid.Column="0" Classes="ghost" Padding="10,6" Command="{Binding BackToListCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="←" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="목록" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                      Margin="10,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsDocConnected}">
            <Path Data="{Binding ActiveDocApp, Converter={x:Static vm:Converters.AppIcon}}"
                  Stroke="{Binding ActiveDocApp, Converter={x:Static vm:Converters.AppBrush}}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ActiveDocName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Border Background="{DynamicResource ActivityBgBrush}" CornerRadius="999" Padding="8,2">
              <TextBlock Text="연결됨" FontSize="10.5" Foreground="{DynamicResource GoodBrush}" />
            </Border>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="ChatScroll"
                      Padding="0,10,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
        <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="3*" MaxWidth="760" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}" VerticalAlignment="Top">
            <ItemsControl.Styles>
              <Style Selector="ContentPresenter"><Setter Property="Margin" Value="0,0,0,16" /></Style>
            </ItemsControl.Styles>
            <ItemsControl.DataTemplates>

              <DataTemplate DataType="vm:UserItem">
                <Border Background="{DynamicResource UserBubbleBrush}" CornerRadius="16,16,4,16"
                        Padding="15,11" HorizontalAlignment="Right" MaxWidth="560">
                  <TextBlock Text="{Binding Text}" Foreground="White" FontSize="14" LineHeight="20" />
                </Border>
              </DataTemplate>

              <DataTemplate DataType="vm:AssistantItem">
                <StackPanel HorizontalAlignment="Left" MaxWidth="660" Spacing="5">
                  <TextBlock Text="MoAI" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"
                             Foreground="{DynamicResource AccentHoverBrush}" />
                  <Border Background="{DynamicResource ActivityBgBrush}" CornerRadius="4,16,16,16"
                          Padding="16,11" HorizontalAlignment="Left">
                    <controls:MarkdownBlock Markdown="{Binding Text}"
                                            TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
                  </Border>
                </StackPanel>
              </DataTemplate>

              <DataTemplate DataType="vm:ActivityItem">
                <Border Background="{DynamicResource ActivityBgBrush}" CornerRadius="9" Padding="11,7" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                IsVisible="{Binding !Done}">
                      <Ellipse Classes="bounce b1" />
                      <Ellipse Classes="bounce b2" />
                      <Ellipse Classes="bounce b3" />
                    </StackPanel>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding Done}"
                             Fill="{Binding Done, Converter={x:Static vm:Converters.DoneToBrush}}" />
                    <TextBlock Text="{Binding Text}" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>

              <DataTemplate DataType="vm:ConfirmItem">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentHoverBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="16,13" HorizontalAlignment="Left" MaxWidth="560">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                      <Path Grid.Column="0" Classes="icon" Data="{StaticResource Icon.Pencil}"
                            VerticalAlignment="Top" Margin="0,2,10,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right"
                                IsVisible="{Binding !Decided}">
                      <Button Classes="ghost" Content="취소" Command="{Binding RejectCommand}" />
                      <Button Classes="ghost" Content="계속 허용" Command="{Binding ApproveAllCommand}"
                              ToolTip.Tip="이후 이 문서 편집은 확인 없이 자동 적용" />
                      <Button Classes="accent" Content="적용" Command="{Binding ApproveCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ResultLabel}" IsVisible="{Binding Decided}" FontSize="12.5"
                               HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>

              <DataTemplate DataType="vm:SuggestionItem">
                <ItemsControl ItemsSource="{Binding Suggestions}" HorizontalAlignment="Left">
                  <ItemsControl.Styles>
                    <Style Selector="ContentPresenter">
                      <Setter Property="Margin" Value="0" />
                    </Style>
                  </ItemsControl.Styles>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="suggestion" Content="{Binding}" Margin="0,0,0,7"
                              HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                              Command="{Binding $parent[Window].DataContext.UseSuggestionCommand}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>

              <!-- 데이터 출처 선택 카드(템플릿 작성) -->
              <DataTemplate DataType="vm:SourceChoiceItem">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentHoverBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="16,13" HorizontalAlignment="Left" MaxWidth="560">
                  <StackPanel Spacing="11">
                    <TextBlock Text="입력할 데이터를 어디서 가져올까요?" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Topic}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <WrapPanel>
                      <Button Classes="chip" Margin="0,0,7,7" Content="조직 데이터 검색"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectSourceCommand}" CommandParameter="org" />
                      <Button Classes="chip" Margin="0,0,7,7" Content="웹 검색"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectSourceCommand}" CommandParameter="web" />
                      <Button Classes="chip" Margin="0,0,7,7" Content="둘 다"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectSourceCommand}" CommandParameter="both" />
                      <Button Classes="chip" Margin="0,0,7,7" Content="안 가져옴"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectSourceCommand}" CommandParameter="none" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>

              <DataTemplate DataType="vm:DocumentItem">
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        Padding="16" HorizontalAlignment="Left" MaxWidth="520">
                  <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="13">
                      <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                        <Path Data="{Binding Icon, Converter={x:Static vm:Converters.IconKey}}"
                              Stroke="{DynamicResource AccentHoverBrush}" StrokeThickness="1.7"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              Width="24" Height="24" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding FileName}" FontSize="14.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path}" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="accent"
                              Command="{Binding $parent[ItemsControl].DataContext.OpenGeneratedDocCommand}"
                              CommandParameter="{Binding}">열어서 편집</Button>
                      <Button Classes="ghost"
                              Command="{Binding $parent[ItemsControl].DataContext.RevealDocCommand}"
                              CommandParameter="{Binding}">폴더 열기</Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>

            </ItemsControl.DataTemplates>
          </ItemsControl>
        </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" IsVisible="{Binding IsEditChatEmpty}" IsHitTestVisible="False"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="440">
          <TextBlock Text="주제를 입력해 주세요" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Text="아래 입력창의 「(주제)」 자리에 주제를 넣고 보내면 그 서식으로 작성합니다." />
        </StackPanel>
      </Grid>

      <!-- ── 하단 작성 영역 (Row3; 편집 대화일 때만) ── -->
      <Grid Grid.Row="3" IsVisible="{Binding IsEditChat}" Margin="0,8,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="3*" MaxWidth="760" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Spacing="12">

          <ItemsControl ItemsSource="{Binding References}" IsVisible="{Binding HasReferences}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource ActivityBgBrush}" CornerRadius="9"
                        Padding="10,5" Margin="0,0,7,7">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Classes="icon sm" Data="{Binding Icon, Converter={x:Static vm:Converters.IconKey}}"
                          Width="13" Height="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" VerticalAlignment="Center" />
                    <Button Classes="ghost" Padding="4,2" MinWidth="0"
                            Command="{Binding $parent[ItemsControl].DataContext.RemoveReferenceCommand}"
                            CommandParameter="{Binding}">
                      <Path Classes="icon" Data="{StaticResource Icon.X}" Width="12" Height="12" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Background="{DynamicResource BgInputBrush}" CornerRadius="24"
                  BorderBrush="{Binding ActiveDocApp, Converter={x:Static vm:Converters.InputOutline}}"
                  BorderThickness="1.5" Padding="8,6">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
              <Button Grid.Column="0" x:Name="DocButton" IsVisible="{Binding IsDocConnected}" Classes="ghost"
                      VerticalAlignment="Center" Padding="8" ToolTip.Tip="연결된 문서 · 클릭하여 해제">
                <Path Data="{Binding ActiveDocApp, Converter={x:Static vm:Converters.AppIcon}}"
                      Stroke="{Binding ActiveDocApp, Converter={x:Static vm:Converters.AppBrush}}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                      Width="17" Height="17" Stretch="Uniform" />
                <Button.Flyout>
                  <Flyout Placement="Top">
                    <StackPanel Spacing="11" MaxWidth="240" Margin="4">
                      <TextBlock Text="{Binding DetachPrompt}" TextWrapping="Wrap" FontSize="13"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <Button Classes="accent" Content="연결 해제" HorizontalAlignment="Right"
                              Click="OnDetachConfirm" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Padding="8"
                      Click="OnAttachClick" ToolTip.Tip="로컬 참조 문서 첨부">
                <Path Classes="icon" Data="{StaticResource Icon.Paperclip}" Width="16" Height="16" />
              </Button>
              <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Center" Padding="8"
                      Click="OnOrgClick" ToolTip.Tip="조직 문서함에서 검색·첨부">
                <Path Classes="icon" Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
              </Button>
              <TextBox Grid.Column="3" x:Name="Composer" Classes="composer" Margin="8,0,8,0"
                       Watermark="열린 문서에 지시하세요…" Text="{Binding Input}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="4" Classes="send" Command="{Binding SendCommand}"
                      Background="{Binding ActiveDocApp, Converter={x:Static vm:Converters.SendBrush}}">
                <Path Classes="icon on-accent" Data="{StaticResource Icon.ArrowUp}" />
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- ═══ 주제 입력 팝업(오버레이) ═══ -->
    <Border IsVisible="{Binding ShowTopicDialog}" Background="#88000000">
      <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
              BorderThickness="1" CornerRadius="16" Padding="22" MaxWidth="440" Width="420"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock FontSize="15.5" FontWeight="SemiBold"
                     Text="{Binding TopicTemplateLabel, StringFormat='{}{0} · 주제를 입력하세요'}" />
          <TextBlock Text="어떤 주제로 작성할까요? (예: AI 거버넌스 체계 수립 방안)" FontSize="12.5"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBox x:Name="TopicBox" Watermark="주제 입력…" Text="{Binding TopicInput}" FontSize="14">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ConfirmTopicCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="취소" Command="{Binding CancelTopicCommand}" />
            <Button Classes="accent" Content="작성 시작" Command="{Binding ConfirmTopicCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
