<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoaiCode.Gui.ViewModels"
        xmlns:views="using:MoaiCode.Gui.Views"
        xmlns:controls="using:MoaiCode.Gui.Controls"
        x:Class="MoaiCode.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MoAI Desktop"
        Width="1120" Height="760" MinWidth="900" MinHeight="580"
        Background="{DynamicResource BgWindowBrush}"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        WindowStartupLocation="CenterScreen">

  <Grid>

    <!-- ═══ 로그인 (전체 창, 미인증) ═══ -->
    <Panel IsVisible="{Binding !IsAuthed}">
      <views:LoginView DataContext="{Binding Login}" />
    </Panel>

    <!-- ═══ 앱 (인증) ═══ -->
    <!-- RowDefinitions="*,Auto": 우측 콘텐츠(Row0)와 채팅 입력(Row1)을 물리적으로 분리해
         ScrollViewer 가 입력창 영역을 침범하지 못하게 한다(스크롤 constrained 보장). -->
    <Grid ColumnDefinitions="270,*" RowDefinitions="*,Auto" IsVisible="{Binding IsAuthed}">

      <!-- ── 사이드바 ── -->
      <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource BgSidebarBrush}"
              BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="18,20,18,16">

          <!-- 상단: 로고 + 새 작업 -->
          <StackPanel DockPanel.Dock="Top" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <Image Source="avares://MoaiCode.Gui/Assets/moai-logo.png" Width="34" Height="34" />
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="MoAI Desktop" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AppVersion}" FontSize="10.5" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Text="문서를 말로 만드세요" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
            </StackPanel>
            <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding NewTaskCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Path Classes="icon on-accent" Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
                <TextBlock Text="새 작업" VerticalAlignment="Center" Foreground="White" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- 하단: 계정(이름/소속) + 설정(톱니바퀴) -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="icon" Data="{StaticResource Icon.User}" Width="13" Height="13"
                    VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock Grid.Column="1" Text="{Binding AccountLabel}" FontSize="12.5" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
              <Button Grid.Column="2" Classes="ghost" Padding="7,5"
                      Command="{Binding OpenSettingsCommand}" ToolTip.Tip="계정 · 모델 설정">
                <Path Classes="icon" Data="{StaticResource Icon.Settings}" />
              </Button>
            </Grid>
          </StackPanel>

          <!-- 중앙: 상=열린 Office 문서, 하=대화 기록 -->
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- 열린 문서 (상): 런처 — 클릭 시 그 문서로 편집 세션 시작 -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,2,0,4">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{DynamicResource AccentHoverBrush}" IsVisible="{Binding HasOpenDocs}" />
                <TextBlock Text="열린 문서" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Padding="6,3"
                      Command="{Binding RefreshOfficeCommand}" ToolTip.Tip="목록 새로고침">
                <Path Classes="icon sm" Data="{StaticResource Icon.RefreshCw}" />
              </Button>
            </Grid>
            <Panel Grid.Row="1">
              <ScrollViewer MaxHeight="150" IsVisible="{Binding HasOpenDocs}">
                <ItemsControl ItemsSource="{Binding OfficeDocs}" Margin="0,0,10,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="sideitem" Margin="0,1"
                              Command="{Binding $parent[ItemsControl].DataContext.PickOpenDocCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="이 문서로 편집 작업 시작">
                        <Grid ColumnDefinitions="Auto,*">
                          <Path Grid.Column="0" Classes="icon sm" VerticalAlignment="Center" Margin="0,0,7,0"
                                Data="{Binding App, Converter={x:Static vm:Converters.AppIcon}}"
                                Stroke="{Binding App, Converter={x:Static vm:Converters.AppBrush}}" />
                          <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- 빈 상태: 큰 공백 대신 1줄 안내 -->
              <TextBlock IsVisible="{Binding !HasOpenDocs}" Margin="4,2,0,4" TextWrapping="Wrap"
                         FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                         Text="열린 문서 없음 · Word·Excel·PowerPoint에서 문서를 열고 새로고침을 누르면 여기에 표시됩니다." />
            </Panel>

            <!-- 구분선 + 대화 기록 헤더 -->
            <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,10" />
            <TextBlock Grid.Row="3" Text="대화 기록" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,6" />

            <!-- 대화 기록 (하): 유형 배지 + 제목 + 부제(편집은 대상 파일명) -->
            <ScrollViewer Grid.Row="4">
              <!-- 우측 여백: 오버레이 스크롤바가 항목 텍스트를 가리지 않도록 -->
              <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,0,10,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- 행(로드) 버튼과 삭제(✕) 버튼을 Grid 형제로 — 버튼 중첩 클릭 충돌 방지 -->
                    <Grid Margin="0,1">
                      <Button Classes="sideitem"
                              Command="{Binding $parent[ItemsControl].DataContext.LoadSessionCommand}"
                              CommandParameter="{Binding}">
                        <!-- Grid(Auto,*,Auto): 제목/부제가 남은 폭으로 제한돼 …말줄임(오른쪽 ✕ 자리 확보) -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Path Grid.Column="0" Classes="icon sm" Margin="0,0,8,0"
                                Data="{Binding KindIcon, Converter={x:Static vm:Converters.IconKey}}"
                                VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="2" Width="22" Margin="6,0,0,0" />
                        </Grid>
                      </Button>
                      <Button Classes="rowdel" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                              ToolTip.Tip="대화 삭제"
                              Command="{Binding $parent[ItemsControl].DataContext.DeleteSessionCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon sm" Data="{StaticResource Icon.X}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ── 우측 콘텐츠: 채팅 스크롤 | 설정 | 홈 (앱 Grid Row0 셀에 Z겹침, IsVisible 로 전환).
           Panel 을 없애고 ScrollViewer 를 Grid 셀에 직접 둬서 star 행 제약이 확실히 전달되게 함. -->

        <!-- 설정 패널 -->
        <views:SettingsView Grid.Column="1" Grid.Row="0" IsVisible="{Binding ShowSettings}" />

        <!-- 홈(시작) 화면: 첫 실행(교육형) / 재방문(최근 작업)으로 상태 분기 -->
        <Grid Grid.Column="1" Grid.Row="0" IsVisible="{Binding IsHomeVisible}">

          <!-- ── 첫 실행: 중앙 타일 2개 + 시작 예시 칩 ── -->
          <Grid IsVisible="{Binding !HasRecent}" RowDefinitions="*,Auto,Auto,Auto,*">
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="22">
              <Button Classes="tile" Command="{Binding NewConversationCommand}">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                  <Path Data="{StaticResource Icon.MessageSquare}" Stroke="{DynamicResource AccentHoverBrush}"
                        StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center" />
                  <TextBlock Text="새로운 대화" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
              </Button>
              <Button Classes="tile" Click="OnOfficeDocClick">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                  <Path Data="{StaticResource Icon.Presentation}" Stroke="{DynamicResource AccentHoverBrush}"
                        StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                        Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center" />
                  <TextBlock Text="새로운 오피스 문서 작업" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="이렇게 시작해보세요" HorizontalAlignment="Center" Margin="0,34,0,14"
                       FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
            <WrapPanel Grid.Row="3" HorizontalAlignment="Center" MaxWidth="640">
              <Button Classes="chip" Margin="5" Command="{Binding UseSuggestionCommand}"
                      CommandParameter="이 견적서 요약해줘">이 견적서 요약해줘</Button>
              <Button Classes="chip" Margin="5" Command="{Binding UseSuggestionCommand}"
                      CommandParameter="3분기 실적 슬라이드 만들어줘">3분기 실적 슬라이드 만들어줘</Button>
              <Button Classes="chip" Margin="5" Command="{Binding UseSuggestionCommand}"
                      CommandParameter="예산안 엑셀에 증감률 넣어줘">예산안 엑셀에 증감률 넣어줘</Button>
              <Button Classes="chip" Margin="5" Command="{Binding UseSuggestionCommand}"
                      CommandParameter="이 계약서 초안 만들어줘">이 계약서 초안 만들어줘</Button>
            </WrapPanel>
          </Grid>

          <!-- ── 재방문: 최근 작업 카드 + 새로 시작 ── -->
          <ScrollViewer IsVisible="{Binding HasRecent}" HorizontalScrollBarVisibility="Disabled" Padding="36,32,36,32">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="12">
              <TextBlock Text="최근 작업" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <ItemsControl ItemsSource="{Binding RecentItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- 카드(로드) 버튼 위에 삭제(✕) 버튼을 형제로 겹침 -->
                    <Grid Width="232" Margin="0,0,12,12">
                      <Button Classes="recentcard"
                              Command="{Binding $parent[ItemsControl].DataContext.LoadSessionCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Width="196">
                          <Border Grid.RowSpan="2" Width="30" Height="30" CornerRadius="8" Margin="0,0,11,0"
                                  Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <Path Classes="icon" Data="{Binding KindIcon, Converter={x:Static vm:Converters.IconKey}}"
                                  Stroke="{DynamicResource AccentHoverBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,20,0"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Subtitle}" FontSize="11.5" Margin="0,3,0,0"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Button>
                      <Button Classes="rowdel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                              ToolTip.Tip="대화 삭제"
                              Command="{Binding $parent[ItemsControl].DataContext.DeleteSessionCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon sm" Data="{StaticResource Icon.X}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="새로 시작" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="tile sm" Command="{Binding NewConversationCommand}">
                  <StackPanel Spacing="9" HorizontalAlignment="Center">
                    <Path Data="{StaticResource Icon.MessageSquare}" Stroke="{DynamicResource AccentHoverBrush}"
                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
                    <TextBlock Text="새로운 대화" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Button>
                <Button Classes="tile sm" Click="OnOfficeDocClick">
                  <StackPanel Spacing="9" HorizontalAlignment="Center">
                    <Path Data="{StaticResource Icon.Presentation}" Stroke="{DynamicResource AccentHoverBrush}"
                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
                    <TextBlock Text="오피스 문서 작업" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

          <!-- 채팅 스크롤 (앱 Grid Row0 직속; 입력은 앱 Grid 하단 Row1 로 물리 분리).
               AllowAutoHide=False: Fluent 오버레이 스크롤바가 마지막 줄을 덮는 것 방지. -->
          <ScrollViewer Grid.Column="1" Grid.Row="0" x:Name="ChatScroll" IsVisible="{Binding IsChatVisible}"
                        Padding="0,22,0,0" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <!-- 하단 여백은 ScrollViewer.Padding 이 아니라 콘텐츠 Margin 으로 준다.
                 Padding 은 Extent 에 포함되지 않아 StickyBottomScroll 의 (Extent-Viewport)
                 하단 고정 계산에서 무시된다 → 마지막 말풍선이 입력창 뒤로 가려지던 근본 원인. -->
            <Grid Margin="0,0,0,56">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3*" MaxWidth="760" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}" VerticalAlignment="Top">
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter"><Setter Property="Margin" Value="0,0,0,16" /></Style>
              </ItemsControl.Styles>
              <ItemsControl.DataTemplates>

                <!-- 사용자 말풍선 -->
                <DataTemplate DataType="vm:UserItem">
                  <Border Background="{DynamicResource UserBubbleBrush}" CornerRadius="16,16,4,16"
                          Padding="15,11" HorizontalAlignment="Right" MaxWidth="560">
                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="14" LineHeight="20" />
                  </Border>
                </DataTemplate>

                <!-- MoAI 말풍선 (마크다운) -->
                <DataTemplate DataType="vm:AssistantItem">
                  <StackPanel HorizontalAlignment="Left" MaxWidth="660" Spacing="5">
                    <TextBlock Text="MoAI" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"
                               Foreground="{DynamicResource AccentHoverBrush}" />
                    <Border Background="{DynamicResource ActivityBgBrush}" CornerRadius="4,16,16,16"
                            Padding="16,11" HorizontalAlignment="Left">
                      <controls:MarkdownBlock Markdown="{Binding Text}"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                  </StackPanel>
                </DataTemplate>

                <!-- 진행 배지 -->
                <DataTemplate DataType="vm:ActivityItem">
                  <Border Background="{DynamicResource ActivityBgBrush}" CornerRadius="9" Padding="11,7" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <!-- 진행 중: 통통 튀는 점 3개(바운스) -->
                      <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                  IsVisible="{Binding !Done}">
                        <Ellipse Classes="bounce b1" />
                        <Ellipse Classes="bounce b2" />
                        <Ellipse Classes="bounce b3" />
                      </StackPanel>
                      <!-- 완료: 정적 점(초록/빨강) -->
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding Done}"
                               Fill="{Binding Done, Converter={x:Static vm:Converters.DoneToBrush}}" />
                      <TextBlock Text="{Binding Text}" FontSize="12.5" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>

                <!-- 확인 카드(미리보기 게이트): 라이브 편집 전 적용/취소 -->
                <DataTemplate DataType="vm:ConfirmItem">
                  <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentHoverBrush}"
                          BorderThickness="1" CornerRadius="14" Padding="16,13" HorizontalAlignment="Left" MaxWidth="560">
                    <StackPanel Spacing="12">
                      <!-- 아이콘 Auto + 텍스트 star 로 제약해야 긴 문구가 상자 안에서 줄바꿈된다.
                           (가로 StackPanel 은 자식에 무한 너비를 줘서 wrap 이 동작하지 않음) -->
                      <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Data="{StaticResource Icon.Pencil}"
                              VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right"
                                  IsVisible="{Binding !Decided}">
                        <Button Classes="ghost" Content="취소" Command="{Binding RejectCommand}" />
                        <Button Classes="ghost" Content="계속 허용" Command="{Binding ApproveAllCommand}"
                                ToolTip.Tip="이후 이 문서 편집은 확인 없이 자동 적용" />
                        <Button Classes="accent" Content="적용" Command="{Binding ApproveCommand}" />
                      </StackPanel>
                      <TextBlock Text="{Binding ResultLabel}" IsVisible="{Binding Decided}" FontSize="12.5"
                                 HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>

                <!-- 추천 질문(클릭 버튼): 1열 3행 세로 나열 -->
                <DataTemplate DataType="vm:SuggestionItem">
                  <ItemsControl ItemsSource="{Binding Suggestions}" HorizontalAlignment="Left">
                    <ItemsControl.Styles>
                      <!-- 채팅 ItemsControl 의 ContentPresenter Margin(16) 상속 차단 -->
                      <Style Selector="ContentPresenter">
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="suggestion" Content="{Binding}" Margin="0,0,0,7"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                Command="{Binding $parent[Window].DataContext.UseSuggestionCommand}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>

                <!-- 문서 카드 -->
                <DataTemplate DataType="vm:DocumentItem">
                  <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14"
                          BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                          Padding="16" HorizontalAlignment="Left" MaxWidth="520">
                    <StackPanel Spacing="14">
                      <StackPanel Orientation="Horizontal" Spacing="13">
                        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                          <Path Data="{Binding Icon, Converter={x:Static vm:Converters.IconKey}}"
                                Stroke="{DynamicResource AccentHoverBrush}" StrokeThickness="1.7"
                                StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                Width="24" Height="24" Stretch="Uniform"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding FileName}" FontSize="14.5" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Path}" FontSize="11.5"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>

              </ItemsControl.DataTemplates>
            </ItemsControl>
            </Grid>
          </ScrollViewer>

      <!-- ── 하단 작성 영역 (앱 Grid Row1 로 물리 분리; 채팅일 때만) ── -->
      <Grid Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsChatVisible}" Margin="0,8,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="3*" MaxWidth="760" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Spacing="12">

          <!-- 참조 문서 칩(모드 B) -->
          <ItemsControl ItemsSource="{Binding References}" IsVisible="{Binding HasReferences}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource ActivityBgBrush}" CornerRadius="9"
                        Padding="10,5" Margin="0,0,7,7">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Classes="icon sm" Data="{Binding Icon, Converter={x:Static vm:Converters.IconKey}}"
                          Width="13" Height="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" VerticalAlignment="Center" />
                    <Button Classes="ghost" Padding="4,2" MinWidth="0"
                            Command="{Binding $parent[ItemsControl].DataContext.RemoveReferenceCommand}"
                            CommandParameter="{Binding}">
                      <Path Classes="icon" Data="{StaticResource Icon.X}" Width="12" Height="12" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 입력창: 편집 연결 중이면 윤곽선이 앱 색으로. 좌측 앱 버튼으로 연결 해제. -->
          <Border Background="{DynamicResource BgInputBrush}" CornerRadius="24"
                  BorderBrush="{Binding ActiveDocApp, Converter={x:Static vm:Converters.InputOutline}}"
                  BorderThickness="1.5" Padding="8,6">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
              <!-- 연결된 문서(앱) 버튼: 클릭 시 해제 확인 -->
              <Button Grid.Column="0" x:Name="DocButton" IsVisible="{Binding IsDocConnected}" Classes="ghost"
                      VerticalAlignment="Center" Padding="8" ToolTip.Tip="연결된 문서 · 클릭하여 해제">
                <Path Data="{Binding ActiveDocApp, Converter={x:Static vm:Converters.AppIcon}}"
                      Stroke="{Binding ActiveDocApp, Converter={x:Static vm:Converters.AppBrush}}"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                      Width="17" Height="17" Stretch="Uniform" />
                <Button.Flyout>
                  <Flyout Placement="Top">
                    <StackPanel Spacing="11" MaxWidth="240" Margin="4">
                      <TextBlock Text="{Binding DetachPrompt}" TextWrapping="Wrap" FontSize="13"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                      <Button Classes="accent" Content="연결 해제" HorizontalAlignment="Right"
                              Click="OnDetachConfirm" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Padding="8"
                      Click="OnAttachClick" ToolTip.Tip="로컬 참조 문서 첨부">
                <Path Classes="icon" Data="{StaticResource Icon.Paperclip}" Width="16" Height="16" />
              </Button>
              <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Center" Padding="8"
                      Click="OnOrgClick" ToolTip.Tip="조직 문서함에서 검색·첨부">
                <Path Classes="icon" Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
              </Button>
              <TextBox Grid.Column="3" Classes="composer" Margin="8,0,8,0"
                       Watermark="무엇을 만들어 드릴까요?" Text="{Binding Input}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="4" Classes="send" Command="{Binding SendCommand}"
                      Background="{Binding ActiveDocApp, Converter={x:Static vm:Converters.SendBrush}}">
                <Path Classes="icon on-accent" Data="{StaticResource Icon.ArrowUp}" />
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
