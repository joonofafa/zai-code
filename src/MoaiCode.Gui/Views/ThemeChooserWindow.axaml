<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="using:MoaiCode.Gui.Localization"
        x:Class="MoaiCode.Gui.Views.ThemeChooserWindow"
        Title="MoAI Desktop"
        Width="640" Height="440" CanResize="False"
        Background="#0B1120"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        WindowStartupLocation="CenterScreen">

  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="26" MaxWidth="520">

    <StackPanel Spacing="8" HorizontalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="11">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#3B82F6" Offset="0" />
              <GradientStop Color="#2563EB" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="M" FontSize="20" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="MoAI Desktop" FontSize="22" FontWeight="SemiBold"
                   Foreground="#F8FAFC" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{l10n:Loc gui.theme.prompt}"
                 FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">

      <!-- 라이트 -->
      <Button Name="LightCard" Classes="themecard" Click="OnLight">
        <StackPanel Spacing="12">
          <Border Width="200" Height="128" CornerRadius="10" Background="#FFFFFF" ClipToBounds="True">
            <Grid ColumnDefinitions="56,*">
              <Border Grid.Column="0" Background="#F1F5F9" />
              <StackPanel Grid.Column="1" Margin="12,14" Spacing="7">
                <Border Height="10" Width="120" CornerRadius="5" Background="#E2E8F0" HorizontalAlignment="Left" />
                <Border Height="26" Width="96" CornerRadius="7" Background="#DBEAFE" HorizontalAlignment="Right" />
                <Border Height="10" Width="108" CornerRadius="5" Background="#E2E8F0" HorizontalAlignment="Left" />
                <Border Height="22" Width="60" CornerRadius="6" Background="#3B82F6" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="{l10n:Loc gui.theme.light}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- 다크 -->
      <Button Name="DarkCard" Classes="themecard" Click="OnDark">
        <StackPanel Spacing="12">
          <Border Width="200" Height="128" CornerRadius="10" Background="#020817" ClipToBounds="True">
            <Grid ColumnDefinitions="56,*">
              <Border Grid.Column="0" Background="#0B1120" />
              <StackPanel Grid.Column="1" Margin="12,14" Spacing="7">
                <Border Height="10" Width="120" CornerRadius="5" Background="#1E293B" HorizontalAlignment="Left" />
                <Border Height="26" Width="96" CornerRadius="7" Background="#1D3A8A" HorizontalAlignment="Right" />
                <Border Height="10" Width="108" CornerRadius="5" Background="#1E293B" HorizontalAlignment="Left" />
                <Border Height="22" Width="60" CornerRadius="6" Background="#3B82F6" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="{l10n:Loc gui.theme.dark}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
        </StackPanel>
      </Button>

    </StackPanel>
  </StackPanel>

  <Window.Styles>
    <Style Selector="Button.themecard">
      <Setter Property="Background" Value="#0F172A" />
      <Setter Property="BorderBrush" Value="#1E293B" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.themecard:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#111C33" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
    </Style>
  </Window.Styles>
</Window>
