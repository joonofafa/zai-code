<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoaiCode.Gui.ViewModels"
        x:Class="MoaiCode.Gui.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="MoAI Desktop 로그인" Width="440" Height="620"
        WindowStartupLocation="CenterScreen" CanResize="False"
        Background="{DynamicResource BgWindowBrush}">

  <ScrollViewer>
    <StackPanel Margin="34,30" Spacing="18" MaxWidth="372">

      <!-- 로고 / 제목 -->
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource UserBubbleBrush}">
          <TextBlock Text="M" FontWeight="Bold" FontSize="21" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MoAI Desktop" FontWeight="SemiBold" FontSize="18"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="로그인하고 시작하세요" FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
      </StackPanel>

      <!-- 사내 프록시 설정 (접이식) -->
      <Expander Header="사내 프록시 설정 (필요 시)" IsExpanded="{Binding ProxyExpanded}">
        <StackPanel Spacing="9" Margin="0,10,0,2">
          <TextBlock Text="사내 프록시 뒤에서 접속하는 경우 입력하세요. 로그인 전에 적용됩니다."
                     FontSize="11.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBox Watermark="프록시 URL (예: http://proxy.corp:8080)" Text="{Binding ProxyUrl}" />
          <TextBox Watermark="프록시 사용자 (선택)" Text="{Binding ProxyUser}" />
          <TextBox Watermark="프록시 비밀번호 (선택)" Text="{Binding ProxyPassword}" PasswordChar="●" />
        </StackPanel>
      </Expander>

      <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />

      <!-- 로그인 폼 -->
      <StackPanel Spacing="11">
        <TextBox Watermark="이메일" Text="{Binding Email}" />
        <TextBox Watermark="비밀번호" Text="{Binding Password}" PasswordChar="●">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBox Watermark="MFA 코드" Text="{Binding MfaCode}" IsVisible="{Binding MfaRequired}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </StackPanel>

      <Button Classes="accent" Content="로그인" HorizontalAlignment="Stretch" Height="40"
              Command="{Binding LoginCommand}" IsEnabled="{Binding !Busy}" />

      <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" MinHeight="18"
                 HorizontalAlignment="Center" TextAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
  </ScrollViewer>
</Window>
