<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoaiCode.Gui.ViewModels"
        xmlns:l10n="using:MoaiCode.Gui.Localization"
        x:Class="MoaiCode.Gui.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="{l10n:Loc gui.login.title}" Width="420" Height="700"
        WindowStartupLocation="CenterScreen" CanResize="False" SizeToContent="Manual"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        Background="{DynamicResource BgWindowBrush}">

  <Window.Styles>
    <!-- Desktop 톤앤매너에 맞춘 둥근 입력 필드 -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    </Style>
  </Window.Styles>

  <ScrollViewer>
    <StackPanel Margin="0,34,0,26" Spacing="14" MaxWidth="332" HorizontalAlignment="Center">

      <!-- 로고 / 제목 -->
      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,0,0,4">
        <Image Source="avares://MoaiCode.Gui/Assets/moai-logo.png" Width="52" Height="52"
               HorizontalAlignment="Center" />
        <TextBlock Text="MoAI Desktop" FontWeight="SemiBold" FontSize="19"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{l10n:Loc gui.login.subtitle}" FontSize="12.5"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>

      <!-- 로그인 단계 -->
      <StackPanel Spacing="14" IsVisible="{Binding !ModelPickStage}">
        <TextBox Watermark="{l10n:Loc gui.login.email}" Text="{Binding Email}" />
        <TextBox Watermark="{l10n:Loc gui.login.password}" Text="{Binding Password}" PasswordChar="●">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBox Watermark="{l10n:Loc gui.login.mfa}" Text="{Binding MfaCode}" IsVisible="{Binding MfaRequired}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Classes="accent" Content="{l10n:Loc gui.login.signIn}" HorizontalAlignment="Stretch" Height="46"
                CornerRadius="12" FontSize="14.5" Command="{Binding LoginCommand}"
                IsEnabled="{Binding !Busy}" />
      </StackPanel>

      <!-- 모델 선택 단계 -->
      <StackPanel Spacing="10" IsVisible="{Binding ModelPickStage}">
        <TextBlock Text="{l10n:Loc gui.login.pickModel}" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                  HorizontalAlignment="Stretch" />
        <Button Classes="accent" Content="{l10n:Loc gui.login.start}" HorizontalAlignment="Stretch" Height="46"
                CornerRadius="12" FontSize="14.5" Command="{Binding StartCommand}" />
      </StackPanel>

      <TextBlock Text="{Binding Status}" FontSize="12.5" TextWrapping="Wrap" MinHeight="16"
                 HorizontalAlignment="Center" TextAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" />

      <!-- 사내 프록시 설정 (로그인 단계에서만 · 로그인 아래 · 동일 폭 · 접이식) -->
      <Expander Header="{l10n:Loc gui.login.proxyHeader}" IsExpanded="{Binding ProxyExpanded}"
                IsVisible="{Binding !ModelPickStage}"
                HorizontalAlignment="Stretch" CornerRadius="12" Margin="0,2,0,0">
        <StackPanel Spacing="10" Margin="2,10,2,4">
          <TextBlock Text="{l10n:Loc gui.login.proxyHint}"
                     FontSize="11.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <TextBox Watermark="{l10n:Loc gui.login.proxyUrl}" Text="{Binding ProxyUrl}" />
          <TextBox Watermark="{l10n:Loc gui.login.proxyUser}" Text="{Binding ProxyUser}" />
          <TextBox Watermark="{l10n:Loc gui.login.proxyPassword}" Text="{Binding ProxyPassword}" PasswordChar="●" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Window>
