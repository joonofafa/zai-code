<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoaiCode.Gui.ViewModels"
        x:Class="MoaiCode.Gui.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding WindowTitle}" Width="400" Height="440"
        WindowStartupLocation="CenterOwner" CanResize="False"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        Background="{DynamicResource BgWindowBrush}">

  <Window.Styles>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    </Style>
  </Window.Styles>

  <Grid Margin="24,22" RowDefinitions="Auto,Auto,*,Auto">

    <!-- 계정 -->
    <StackPanel Grid.Row="0" Spacing="3">
      <TextBlock Text="{Binding AccountLabel}" FontSize="11.5" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextMutedBrush}" />
      <TextBlock Text="{Binding AccountName}" FontSize="15.5" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{Binding Email}" FontSize="12"
                 Foreground="{DynamicResource TextMutedBrush}" />
    </StackPanel>

    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,16" />

    <!-- 모델 -->
    <StackPanel Grid.Row="2" Spacing="9" VerticalAlignment="Top">
      <TextBlock Text="{Binding ModelLabel}" FontSize="12.5" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                HorizontalAlignment="Stretch" />
      <TextBlock Text="{Binding ModelHint}"
                 FontSize="11.5" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" />
      <TextBlock Text="{Binding LanguageLabel}" Margin="0,12,0,0"
                 FontSize="12.5" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding LanguageHint}" FontSize="11.5" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMutedBrush}" />
    </StackPanel>

    <!-- 하단 액션 -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
      <Button Grid.Column="0" Classes="ghost" Content="{Binding ReloginText}" Click="OnReLogin" />
      <Button Grid.Column="2" Classes="ghost" Content="{Binding CloseText}" Click="OnCancel" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="accent" Content="{Binding SaveText}" Command="{Binding SaveCommand}" />
    </Grid>
  </Grid>
</Window>
