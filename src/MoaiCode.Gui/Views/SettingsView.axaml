<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoaiCode.Gui.ViewModels"
             x:Class="MoaiCode.Gui.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="40,30,40,0">

    <TextBlock Grid.Row="0" Text="{Binding SettingsTitleText}" FontSize="22" FontWeight="Bold"
               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="540" HorizontalAlignment="Left" Spacing="24">

        <!-- 계정 -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{Binding SettingsAccountText}" />
          <TextBlock Text="{Binding AccountLabel}" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding AccountEmail}" FontSize="12.5"
                     Foreground="{DynamicResource TextMutedBrush}" />

          <!-- 로그아웃 (인라인 확인) -->
          <Button Classes="ghost" Content="{Binding SettingsLogoutText}" HorizontalAlignment="Left" Margin="0,4,0,0"
                  IsVisible="{Binding !ConfirmLogout}" Command="{Binding LogoutCommand}" />
          <Border IsVisible="{Binding ConfirmLogout}" Background="{DynamicResource ActivityBgBrush}"
                  CornerRadius="12" Padding="14,11" Margin="0,4,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding SettingsLogoutConfirmText}"
                         FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="{Binding SettingsCancelText}" Command="{Binding CancelLogoutCommand}" />
                <Button Classes="accent" Content="{Binding SettingsLogoutText}" Command="{Binding LogoutConfirmedCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />

        <!-- 모델 -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{Binding SettingsModelText}" />
          <ComboBox ItemsSource="{Binding SettingsModels}" SelectedItem="{Binding SettingsModel}"
                    MinWidth="280" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding SettingsModelHintText}"
                     FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />

        <!-- 언어 -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{Binding SettingsLanguageText}" />
          <ComboBox ItemsSource="{Binding SettingsLanguages}" SelectedItem="{Binding SettingsLanguage}"
                    MinWidth="280" HorizontalAlignment="Left">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding SettingsLanguageHintText}"
                     FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />

        <!-- 스킬 -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="스킬" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ToggleSwitch IsChecked="{Binding SkillsEnabled}" OnContent="켜짐" OffContent="꺼짐" />
            <TextBlock Text="사용자·팀 공유 스킬을 에이전트가 사용하도록 허용합니다."
                       FontSize="12.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="380" />
          </StackPanel>
          <TextBlock Text="끄면 이번 세션부터 스킬 기능이 비활성화됩니다."
                     FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />

        <!-- 테마 -->
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{Binding SettingsThemeText}" />
          <ToggleSwitch IsChecked="{Binding IsDark}"
                        OnContent="{Binding SettingsDarkModeText}" OffContent="{Binding SettingsLightModeText}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- 하단 구분선 + 적용 -->
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,20">
        <Button Grid.Column="1" Classes="ghost" Content="{Binding SettingsCancelText}" Margin="0,0,8,0"
                Command="{Binding CloseSettingsCommand}" />
        <Button Grid.Column="2" Classes="accent" Content="{Binding SettingsApplyText}" Command="{Binding ApplySettingsCommand}" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
