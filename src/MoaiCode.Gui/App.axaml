<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoaiCode.Gui.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- ═══ 다크 ═══ -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgWindowBrush" Color="#12131A" />
          <SolidColorBrush x:Key="BgSidebarBrush" Color="#181922" />
          <SolidColorBrush x:Key="BgCardBrush" Color="#1F2130" />
          <SolidColorBrush x:Key="BgInputBrush" Color="#232637" />
          <SolidColorBrush x:Key="BgChipBrush" Color="#242637" />
          <SolidColorBrush x:Key="BorderSoftBrush" Color="#2C2F42" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEDF6" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9C9FB7" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7189" />
          <SolidColorBrush x:Key="AccentBrush" Color="#6D5EF0" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#8073F5" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2748" />
          <SolidColorBrush x:Key="GoodBrush" Color="#3FB68B" />
          <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1EFFFFFF" />
          <SolidColorBrush x:Key="ActivityBgBrush" Color="#14FFFFFF" />
          <LinearGradientBrush x:Key="UserBubbleBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#5C4FEA" Offset="0" />
            <GradientStop Color="#7A5CF2" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <!-- ═══ 라이트 ═══ -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgWindowBrush" Color="#F5F6FB" />
          <SolidColorBrush x:Key="BgSidebarBrush" Color="#ECEEF6" />
          <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgInputBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgChipBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BorderSoftBrush" Color="#E2E5EF" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1D28" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#585B70" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8DA1" />
          <SolidColorBrush x:Key="AccentBrush" Color="#6D5EF0" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#5A4FE0" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECEAFB" />
          <SolidColorBrush x:Key="GoodBrush" Color="#2FA37A" />
          <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0E000000" />
          <SolidColorBrush x:Key="ActivityBgBrush" Color="#EEF0F7" />
          <LinearGradientBrush x:Key="UserBubbleBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#5C4FEA" Offset="0" />
            <GradientStop Color="#7A5CF2" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MoaiCode.Gui/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
