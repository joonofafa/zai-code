<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoaiCode.Gui.App"
             RequestedThemeVariant="Dark">

  <!-- 컬러는 open-moai 웹UI(shadcn 슬레이트 + 블루 악센트 #3B82F6)에 맞춤. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- ═══ 다크 (shadcn .dark: slate) ═══ -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgWindowBrush" Color="#020817" />
          <SolidColorBrush x:Key="BgSidebarBrush" Color="#0B1120" />
          <SolidColorBrush x:Key="BgCardBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="BgInputBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="BgChipBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="BorderSoftBrush" Color="#1E293B" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
          <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#172554" />
          <SolidColorBrush x:Key="GoodBrush" Color="#22C55E" />
          <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1EFFFFFF" />
          <SolidColorBrush x:Key="ActivityBgBrush" Color="#12FFFFFF" />
          <LinearGradientBrush x:Key="UserBubbleBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#2563EB" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>

        <!-- ═══ 라이트 (shadcn :root: slate) ═══ -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgWindowBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="BgSidebarBrush" Color="#F1F5F9" />
          <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgInputBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgChipBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BorderSoftBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
          <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF" />
          <SolidColorBrush x:Key="GoodBrush" Color="#16A34A" />
          <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0E000000" />
          <SolidColorBrush x:Key="ActivityBgBrush" Color="#F1F5F9" />
          <LinearGradientBrush x:Key="UserBubbleBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#2563EB" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MoaiCode.Gui/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
