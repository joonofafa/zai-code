<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoaiCode.Gui.App"
             RequestedThemeVariant="Dark">

  <!-- 컬러는 open-moai 웹UI(shadcn 슬레이트 + 블루 악센트 #3B82F6)에 맞춤. -->
  <Application.Resources>
    <ResourceDictionary>

      <!-- 아이콘: open-moai 와 동일한 lucide(0.454) path. 테마 무관 geometry(색·두께는 Path.icon 스타일). -->
      <StreamGeometry x:Key="Icon.Plus">M5 12h14 M12 5v14</StreamGeometry>
