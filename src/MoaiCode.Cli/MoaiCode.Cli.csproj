<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>zaiCode</AssemblyName>
    <!-- Z.ai Code 1.2.0 — moai-code 에서 갈라져 나온 z.ai 전용 단일 코딩 에이전트.
         (조직 서버 연동·GUI 제거, WebSearch=Gemini grounding, stream-json 프로토콜)
         1.2.17: Edit CRLF 폴백 + 빈 응답 조용한 종료 안내 — Windows CRLF 파일에서 모델의
               LF-only old_string 이 무조건 매칭 실패하던 것("not found" 연발 → 턴 정지 사고)을
               LF→CRLF 정규화 폴백으로 해결, 추론만 흐르고 본문 없는 빈 응답 종료 시 사용자에게
               보이는 안내 출력(스피너만 남던 침묵 종료 방지)
         1.2.16: 권한 게이트 자동 거부 버그 수정 — AutoAct 에서 LLM 위험 분류기의 deny 가
               프롬프트 없이 하드 차단하던 것을 대화형에서는 사람 확인으로 강등(헤드리스는
               fail-closed 유지), 분류기 프롬프트 deny 기준을 '재해적·되돌릴 수 없음'으로
               한정, PermissionDenied 리마인더 중립화(모델이 '사용자가 거부했다'고 전가하는
               것 방지), 거부 콘솔 문구에 '자동 거부' 명시
         1.2.15: /theme 무인자 실행 UX 개선 — 현재 테마 표시 후 즉시 선택기 오픈(/model 과
               동일 패턴), select 서브커맨드는 유지(현재 표시만 생략), 비대화형은 안내문
         1.2.14: 시맨틱 멀티 테마 6종(Dark 3: carbon/violet/zen, Light 3: paper/solar/ivory) —
               TuiTheme 단일 지점 팔레트+Role 토큰, /theme 명령(list·select·id), 설정 영속
               (settings.json theme 키), 전 컴포넌트 하드코딩 색 → 토큰 치환,
               THIRD_PARTY_NOTICES.md(원 팔레트 MIT/BSD-2 라이선스 고지)
         1.2.13: 간헐 테스트 실패 제거 — env/console 전역 상태를 만지는 테스트 4종(HeadlessRunner·
               SlashCommand·SettingsLoader·TabInputPipeline)을 EnvMutating 컬렉션으로 직렬화,
               웹 툴 HttpClient 핸들러 풀 공유(ToolHttp), providers 예외문 L10n, ImageSharp 보안 패치,
               dock-smoke 한 명령 러너 + 게시 게이트
         1.2.12: 티어 모델 상태표기 잔여 제거 — MOAI_MODEL_LOW/MID/HIGH 를 읽기만 하던
               ModelStatusLabel 단일 모델로 단순화, /model·/brainstorming·SettingsLoader 의
               낡은 티어 주석 정리(difficulty 라우팅 회수 마무리)
         1.2.11: 태스크 난이도(difficulty) 티어·모델 라우팅 잔여 코드 제거 — 라우팅은 동작하지
               않았는데 [L]/[M]/[H] 태그만 표시되던 것 회수(TaskCreate/PlanCreate 스키마 단순화)
         1.2.21: 백그라운드 작업 완료 자동 보고 — 턴 종료 시 실행 중 셸이 남으면 대기 배너를
               표시하고 프롬프트로 복귀(대기 중에도 자유 입력), 셸 완료가 프롬프트 대기를
               깨워(PromptInterrupt 웨이크) 결과를 자동 재개 턴으로 보고. 사용자 입력 우선,
               완료 다발은 한 턴에 병합, 자동 턴은 maxTurns 분리
         1.2.20: 네트워크 스톨 3종 방비 — ①응답 헤더 대기 상한(기본 300s, MOAI_HEADER_TIMEOUT_SECONDS,
               방화벽 무음 드롭 시 무한 대기 → transient 재시도) ②SSE idle 타임아웃을 실제 data 줄
               기준으로만 리셋(게이트웨이 keepalive 주석 무력화 차단) ③TUI 권한 다이얼로그 선택적
               만료 거부(MOAI_PERMISSION_TIMEOUT 설정 시, 기본 무한대기 유지)
         1.2.19: BashTool 하드닝 — setsid 새 프로세스 그룹 실행으로 타임아웃 시 kill(-PGID)가
               setsid 데몬·재부팅된 파이프 홀더까지 확정 종료(구조적 누수 제거), 수집 버퍼 락+200k
               상한(살아남은 홀더의 무한 출력·레이스 방지), setsid 부재 플랫폼 폴백
         1.2.18: BashTool 무한 대기 수정 — 백그라운드 자식이 파이프 쓰기 끝을 물고 있으면 메인
               셸 종료 후에도 EOF 가 오지 않아 await 가 영원히 풀리지 않던 버그. 타임아웃 판정을
               독립 레이스(Task.WhenAny)로 전환, 초과 시 프로세스 트리 kill 후 부분 출력 즉시 반환
         1.2.10: 슬래시 명령형 에이전트 턴(/init, /review 등) 중에도 하단 입력창 유지 —
               BottomDock.ReinstallForTurn(): SubmitPrompt 커맨드가 모델 턴을 돌리기 전
               해제된 컴퍼저를 재설치
         1.2.9: BottomDock v4 플로팅 컴퍼저 제거 — 입력창을 창 하단에 고정(세로 긴 창에서
               입력창이 콘텐츠 꼬리 밑에 떠 보이지 않던 문제), 턴 중에도 컴퍼저 유지;
               자체 저작 스킬 2종(xunit-test-writer·cross-layer-change-review) 번들 등재(BundledSkills v10)
         1.2.8: 자체 저작 스킬 3종(code-review·systematic-debugging·source-driven-development)에
               원칙 참조 출처(getsentry Apache-2.0, superpowers/agent-skills MIT) license 표기 — BundledSkills v8
         1.2.7: Apache-2.0 공개 스킬 3종(mcp-builder·skill-creator·webapp-testing) 번들 복원 —
               LICENSE.txt 동봉·license frontmatter /license 표기, BundledSkills v7
         1.2.6: /license 슬래시 명령 — 스킬별 라이선스 표시(bundled=자체 저작, user/plugin=
               frontmatter license:), Skill 레코드 license 메타 추가, zip 루트 README 제거
         1.2.5: 기본 번들 스킬 3종 추가(code-review·systematic-debugging·
               source-driven-development, 자체 저작 영문) — BundledSkills v5
         1.2.4: 페이즈 경계 압축 임계 게이트 — 컨텍스트 30% 미만이면 하베스트·압축 스킵,
               턴 예산 리셋만 수행(저사용 시 주요 작업 문맥 보존), 리마인더 중립화
         1.2.2: 턴 중 리사이즈 잔상 해결 — 스피너 self-cleanup(직전 프레임 행 기억·지움),
               park 행 erase 밴드 포함, 재파킹 빈 행 주입 제거
         1.2.1: 리사이즈 스톰 세이프(CPR drain + stale-geometry guard) — 급격 세로 리사이즈 시
               세로 공란·대화 지움 방지, 타이밍 테스트 결정적 교체
         1.2.0: 세션/메모리 프로젝트별 스코핑, 백그라운드 셸(run_in_background·BashOutput/KillShell),
               입력바 표시폭 클램프(한글 wrap 잔상 제거)
         1.1.0: GEMINI 키 저장소 복원, 붙여넣기 홍수 수정, 큐잉 플래시 피드백, 턴 중 Shift+Tab -->
    <Version>1.2.21</Version>
    <!-- 멀티타깃: win-* RID 는 net10.0-windows(Office COM 툴 포함), 나머지는 net10.0. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <!-- 크로스 게시 대상 (Linux에서 win-x64 self-contained exe 생성 가능) -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- COM Office 편집 툴은 MoAI Desktop(GUI) 전용 — CLI 는 참조하지 않음. -->
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <!-- stream-json 내부 라우팅(TryRoutePermissionResponse) 검증용. -->
    <InternalsVisibleTo Include="MoaiCode.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- 기본 번들 스킬(자체 저작 7종 + Apache-2.0 공개 스킬 2종). 첫 실행 시 ~/.zaicode/bundled-skills 로 추출. -->
    <EmbeddedResource Include="Resources/bundled-skills.zip" LogicalName="bundled-skills.zip" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MoaiCode.Core\MoaiCode.Core.csproj" />
    <ProjectReference Include="..\MoaiCode.Providers\MoaiCode.Providers.csproj" />
    <ProjectReference Include="..\MoaiCode.Tools\MoaiCode.Tools.csproj" />
    <ProjectReference Include="..\MoaiCode.Tools.Bash\MoaiCode.Tools.Bash.csproj" />
    <!-- 닫힌 Office 문서 생성/검증(Open XML) — 전 플랫폼. -->
    <ProjectReference Include="..\MoaiCode.Tools.OpenXml\MoaiCode.Tools.OpenXml.csproj" />
    <ProjectReference Include="..\MoaiCode.Mcp\MoaiCode.Mcp.csproj" />
    <ProjectReference Include="..\MoaiCode.Config\MoaiCode.Config.csproj" />
    <ProjectReference Include="..\MoaiCode.Localization\MoaiCode.Localization.csproj" />
    <ProjectReference Include="..\MoaiCode.Persistence\MoaiCode.Persistence.csproj" />
    <ProjectReference Include="..\MoaiCode.Tui\MoaiCode.Tui.csproj" />
    <ProjectReference Include="..\MoaiCode.Sdk\MoaiCode.Sdk.csproj" />
  </ItemGroup>
</Project>
